{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "velog-alert-mobile",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "RegistryDO"
      },
      {
        "name": "POLL_SHARDS",
        "class_name": "PollShardDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RegistryDO", "PollShardDO"]
    }
  ]
}
